{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherstack.local/schemas/audit-event-v0.json",
  "title": "AetherStack audit event v0",
  "description": "Who did what (MULTI-USER M1+). Append-only log shape for Hub/Team Server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "ts", "actor_user_id", "action"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "actor_user_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "team_id": { "type": "string" },
    "project_id": { "type": "string" },
    "action": {
      "type": "string",
      "enum": [
        "auth.login",
        "auth.logout",
        "auth.denied",
        "project.create",
        "project.member.add",
        "project.member.remove",
        "run.preset",
        "run.graph",
        "run.auto",
        "memory.read",
        "memory.write",
        "lease.acquire",
        "lease.release",
        "lease.deny",
        "workspace.write",
        "admin.config",
        "backup.create"
      ]
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "session",
        "preset",
        "graph",
        "memory",
        "path",
        "project",
        "team",
        "system"
      ]
    },
    "resource_id": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": ["success", "denied", "error"],
      "default": "success"
    },
    "request_id": { "type": "string" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["vscode", "cli", "web", "api", "system"]
        },
        "ip": { "type": "string" },
        "user_agent": { "type": "string" }
      }
    },
    "detail": {
      "type": "object",
      "description": "Non-sensitive structured metadata only; no prompts or secrets",
      "additionalProperties": true
    }
  }
}
