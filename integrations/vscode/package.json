{
  "name": "aetherstack",
  "displayName": "AetherStack",
  "description": "Project AI history overview and multi-model coding via AetherStack (LiteLLM, Open WebUI, Ollama). Windows, macOS, and Linux.",
  "version": "0.3.11",
  "publisher": "AetherStack",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "llm",
    "aetherstack",
    "ollama",
    "continue",
    "litellm",
    "openai",
    "multi-model",
    "macos",
    "osx",
    "apple-silicon"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "aetherstack.openChat",
        "title": "AetherStack: Show Chat View",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aetherstack.openChatEditor",
        "title": "AetherStack: Open Chat in Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "aetherstack.openHub",
        "title": "AetherStack: Open Hub UI",
        "icon": "$(server-environment)"
      },
      {
        "command": "aetherstack.openControlCenter",
        "title": "AetherStack: Open Control Center",
        "icon": "$(dashboard)"
      },
      {
        "command": "aetherstack.startAll",
        "title": "AetherStack: Start All Services",
        "icon": "$(play)"
      },
      {
        "command": "aetherstack.stopAll",
        "title": "AetherStack: Stop All Services",
        "icon": "$(stop)"
      },
      {
        "command": "aetherstack.restartAll",
        "title": "AetherStack: Restart All Services",
        "icon": "$(debug-restart)"
      },
      {
        "command": "aetherstack.refreshServices",
        "title": "AetherStack: Refresh Service State",
        "icon": "$(refresh)"
      },
      {
        "command": "aetherstack.chooseStackPath",
        "title": "AetherStack: Choose Installation Folder"
      },
      {
        "command": "aetherstack.showLogs",
        "title": "AetherStack: Show Backend Logs"
      },
      {
        "command": "aetherstack.scanProject",
        "title": "AetherStack: Scan Project AI History"
      },
      {
        "command": "aetherstack.showOverview",
        "title": "AetherStack: Show Project Overview"
      },
      {
        "command": "aetherstack.configureContinue",
        "title": "AetherStack: Wire Continue.dev to AetherStack"
      },
      {
        "command": "aetherstack.configureWorkspace",
        "title": "AetherStack: Write .vscode Settings for AetherStack"
      },
      {
        "command": "aetherstack.setApiKey",
        "title": "AetherStack: Set API Key Securely"
      },
      {
        "command": "aetherstack.openChatUI",
        "title": "AetherStack: Open Chat UI (Open WebUI)"
      },
      {
        "command": "aetherstack.openModels",
        "title": "AetherStack: List Models (API)"
      },
      {
        "command": "aetherstack.saveSnapshot",
        "title": "AetherStack: Save Chat Snapshot Note"
      },
      {
        "command": "aetherstack.openProjectEngine",
        "title": "AetherStack: Open Project Data Engine"
      }
    ],
    "configuration": {
      "title": "AetherStack",
      "properties": {
        "aetherstack.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000/v1",
          "description": "LiteLLM OpenAI-compatible base URL"
        },
        "aetherstack.apiKey": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Use **AetherStack: Set API Key Securely**. Existing values are migrated to VS Code SecretStorage.",
          "description": "Deprecated plaintext setting; migrated to SecretStorage on activation"
        },
        "aetherstack.chatUiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Open WebUI URL"
        },
        "aetherstack.defaultModel": {
          "type": "string",
          "default": "local-default",
          "description": "Default model id from AetherStack /v1/models"
        },
        "aetherstack.stackPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "AetherStack installation folder containing docker-compose.yml. Auto-detected when possible."
        },
        "aetherstack.autoWireModels": {
          "type": "boolean",
          "default": true,
          "description": "After one-click startup, create a Continue config when none exists using only models marked available by the live capability matrix."
        },
        "aetherstack.showActiveModel": {
          "type": "boolean",
          "default": false,
          "description": "Show the model currently handling inference in the AetherStack view and status bar. Only model aliases and timing are observed."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "aetherstack.chat",
        "name": "aetherstack",
        "fullName": "AetherStack",
        "description": "Ask naturally, or use /research /plan /code /test /bugfix /help.",
        "isSticky": true,
        "commands": [
          { "name": "research", "description": "Find evidence, challenge it, synthesize a sourced conclusion" },
          { "name": "plan", "description": "Turn an objective into a sequenced, risk-aware execution plan" },
          { "name": "code", "description": "Implement a focused feature or refactor with tests and review" },
          { "name": "test", "description": "Design and run efficient unit/integration/regression coverage" },
          { "name": "bugfix", "description": "Reproduce, isolate, repair, and regression-test a defect" },
          { "name": "help", "description": "Show AetherStack commands and available presets" }
        ]
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aetherstack",
          "title": "AetherStack",
          "icon": "media/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "aetherstack-ops",
          "title": "AetherStack",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aetherstack": [
        {
          "id": "aetherstack.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ],
      "aetherstack-ops": [
        {
          "id": "aetherstack.overview",
          "name": "Control & Services"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aetherstack.openChatEditor",
          "when": "view == aetherstack.chatView",
          "group": "navigation@0"
        },
        {
          "command": "aetherstack.openChat",
          "when": "view == aetherstack.overview",
          "group": "navigation@0"
        },
        {
          "command": "aetherstack.openControlCenter",
          "when": "view == aetherstack.overview",
          "group": "navigation@1"
        },
        {
          "command": "aetherstack.startAll",
          "when": "view == aetherstack.overview",
          "group": "navigation@2"
        },
        {
          "command": "aetherstack.refreshServices",
          "when": "view == aetherstack.overview",
          "group": "navigation@3"
        },
        {
          "command": "aetherstack.scanProject",
          "when": "view == aetherstack.overview",
          "group": "navigation@4"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/piksliviksi/aetherstack"
  },
  "bugs": {
    "url": "https://github.com/piksliviksi/aetherstack/issues"
  },
  "homepage": "https://github.com/piksliviksi/aetherstack/blob/main/docs/VSCODE-EXTENSION.md",
  "qna": "https://github.com/piksliviksi/aetherstack/blob/main/docs/VSCODE-EXTENSION.md"
}
