{
  "name": "aetherstack",
  "displayName": "AetherStack",
  "description": "Project AI history overview and multi-model coding via AetherStack (LiteLLM, Open WebUI, Ollama). Windows, macOS, and Linux.",
  "version": "0.3.19",
  "publisher": "AetherStack",
  "license": "PolyForm-Noncommercial-1.0.0",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "llm",
    "aetherstack",
    "ollama",
    "continue",
    "litellm",
    "openai",
    "multi-model",
    "macos",
    "osx",
    "apple-silicon"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify:release": "node ../../scripts/verify-release.mjs",
    "package:vsix": "node ../../scripts/package-vscode.mjs",
    "verify:vsix": "node ../../scripts/verify-vsix.mjs",
    "package:runtime": "node ../../scripts/package-runtime.mjs",
    "verify:runtime": "node ../../scripts/verify-runtime.mjs",
    "release:check": "npm test && npm run verify:release && npm run package:vsix && npm run verify:vsix && npm run package:runtime && npm run verify:runtime"
  },
  "contributes": {
    "commands": [
      {
        "command": "aetherstack.openChat",
        "title": "AetherStack: Show Chat View",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aetherstack.openChatEditor",
        "title": "AetherStack: Open Chat in Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "aetherstack.openHub",
        "title": "AetherStack: Open Hub UI (advanced, browser)",
        "icon": "$(server-environment)"
      },
      {
        "command": "aetherstack.openControlCenter",
        "title": "AetherStack: Open Control Center",
        "icon": "$(dashboard)"
      },
      {
        "command": "aetherstack.startAll",
        "title": "AetherStack: Start All Services",
        "icon": "$(play)"
      },
      {
        "command": "aetherstack.stopAll",
        "title": "AetherStack: Stop All Services",
        "icon": "$(stop)"
      },
      {
        "command": "aetherstack.restartAll",
        "title": "AetherStack: Restart All Services",
        "icon": "$(debug-restart)"
      },
      {
        "command": "aetherstack.refreshServices",
        "title": "AetherStack: Refresh Service State",
        "icon": "$(refresh)"
      },
      {
        "command": "aetherstack.refreshHostClis",
        "title": "AetherStack: Refresh Authenticated Host CLIs"
      },
      {
        "command": "aetherstack.installRuntime",
        "title": "AetherStack: Install Verified Runtime"
      },
      {
        "command": "aetherstack.chooseStackPath",
        "title": "AetherStack: Choose Installation Folder"
      },
      {
        "command": "aetherstack.showLogs",
        "title": "AetherStack: Show Backend Logs"
      },
      {
        "command": "aetherstack.scanProject",
        "title": "AetherStack: Scan Project AI History"
      },
      {
        "command": "aetherstack.showOverview",
        "title": "AetherStack: Show Project Overview"
      },
      {
        "command": "aetherstack.configureContinue",
        "title": "AetherStack: Wire Continue.dev to AetherStack"
      },
      {
        "command": "aetherstack.configureWorkspace",
        "title": "AetherStack: Write .vscode Settings for AetherStack"
      },
      {
        "command": "aetherstack.setApiKey",
        "title": "AetherStack: Set API Key Securely"
      },
      {
        "command": "aetherstack.openChatUI",
        "title": "AetherStack: Open Chat UI (Open WebUI, optional browser client)"
      },
      {
        "command": "aetherstack.openModels",
        "title": "AetherStack: List Models (API)"
      },
      {
        "command": "aetherstack.saveSnapshot",
        "title": "AetherStack: Save Chat Snapshot Note"
      },
      {
        "command": "aetherstack.openProjectEngine",
        "title": "AetherStack: Open Project Data Engine"
      }
    ],
    "configuration": {
      "title": "AetherStack",
      "properties": {
        "aetherstack.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000/v1",
          "description": "LiteLLM OpenAI-compatible base URL"
        },
        "aetherstack.apiKey": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Use **AetherStack: Set API Key Securely**. Existing values are migrated to VS Code SecretStorage.",
          "description": "Deprecated plaintext setting; migrated to SecretStorage on activation"
        },
        "aetherstack.chatUiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Open WebUI URL"
        },
        "aetherstack.defaultModel": {
          "type": "string",
          "default": "local-default",
          "description": "Default model id from AetherStack /v1/models"
        },
        "aetherstack.stackPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "AetherStack installation folder containing docker-compose.yml. Auto-detected when possible."
        },
        "aetherstack.autoWireModels": {
          "type": "boolean",
          "default": true,
          "description": "After one-click startup, create a Continue config when none exists using only models marked available by the live capability matrix."
        },
        "aetherstack.showActiveModel": {
          "type": "boolean",
          "default": true,
          "description": "Show the model currently answering in AetherStack Chat and the status bar. While a reply is running, the active model is always shown."
        },
        "aetherstack.showThoughtProcess": {
          "type": "boolean",
          "default": false,
          "description": "In AetherStack Chat, show lead/worker/review step notes under each answer (toggle from the / menu)."
        },
        "aetherstack.showTokens": {
          "type": "boolean",
          "default": true,
          "description": "In AetherStack Chat, show token usage after each reply (toggle from the / menu)."
        },
        "aetherstack.memoryContextKb": {
          "type": "number",
          "enum": [256, 512, 1024, 2048],
          "default": 512,
          "description": "Unified memory context budget for Auto mode (KiB of text injected from session + vector memory). Default 512 KiB — enough for multi-turn coding without saturating typical local Ollama windows. Cycle from the Chat / menu."
        },
        "aetherstack.autoSequenceMode": {
          "type": "string",
          "enum": ["sequential_exhaustion", "per_request"],
          "enumDescriptions": [
            "Keep using the current model across requests until it reaches a limit, then continue with the next model and finally Ollama.",
            "Begin each new request with the first available model; still fail over when that request hits a limit."
          ],
          "default": "sequential_exhaustion",
          "description": "How Auto advances through the editable model sequence."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "aetherstack.chat",
        "name": "aetherstack",
        "fullName": "AetherStack",
        "description": "Ask naturally, or select a dynamic service with /auto, /preset, or a service shortcut.",
        "isSticky": true,
        "commands": [
          { "name": "research", "description": "Find evidence, challenge it, synthesize a sourced conclusion" },
          { "name": "plan", "description": "Turn an objective into a sequenced, risk-aware execution plan" },
          { "name": "auto", "description": "Return to automatic service selection for this Chat thread" },
          { "name": "preset", "description": "Select a service preset by name, optionally followed by a goal" },
          { "name": "presets", "description": "List service presets available on this system" },
          { "name": "code", "description": "Implement a focused feature or refactor with tests and review" },
          { "name": "test", "description": "Design and run efficient unit/integration/regression coverage" },
          { "name": "bugfix", "description": "Reproduce, isolate, repair, and regression-test a defect" },
          { "name": "ui", "description": "Design a clear accessible user interface" },
          { "name": "frontend", "description": "Implement and review frontend behavior" },
          { "name": "backend", "description": "Implement and review backend behavior" },
          { "name": "security", "description": "Run defensive white-hat security analysis" },
          { "name": "polish", "description": "Polish quality, usability, and maintainability" },
          { "name": "docs", "description": "Produce precise technical documentation" },
          { "name": "help", "description": "Show AetherStack commands and available presets" }
        ]
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aetherstack",
          "title": "AetherStack",
          "icon": "media/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "aetherstack-ops",
          "title": "AetherStack",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aetherstack": [
        {
          "id": "aetherstack.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ],
      "aetherstack-ops": [
        {
          "id": "aetherstack.overview",
          "name": "Control & Services"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aetherstack.openChat",
          "when": "view == aetherstack.overview",
          "group": "navigation@0"
        },
        {
          "command": "aetherstack.openControlCenter",
          "when": "view == aetherstack.overview",
          "group": "navigation@1"
        },
        {
          "command": "aetherstack.startAll",
          "when": "view == aetherstack.overview",
          "group": "navigation@2"
        },
        {
          "command": "aetherstack.refreshServices",
          "when": "view == aetherstack.overview",
          "group": "navigation@3"
        },
        {
          "command": "aetherstack.scanProject",
          "when": "view == aetherstack.overview",
          "group": "navigation@4"
        }
      ]
    }
  },
  "qna": false
}
