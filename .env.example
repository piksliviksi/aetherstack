# Copy to .env and fill in keys you use (leave blank if unused)

# LiteLLM gateway master key (must start with sk-)
# Startup generates a random sk-* key here on first run. Use
# scripts/list-models.ps1 or list-models.sh, or Open WebUI at :3000.
# Also accepted as Hub control-plane admin bearer when AETHER_REQUIRE_AUTH=1.
LITELLM_MASTER_KEY=

# ── Edition / control-plane auth (E1) ───────────────────────────────
# desktop (default): open loopback Hub APIs as today
# team|cloud: treat as multi-user; set AETHER_REQUIRE_AUTH=1
AETHER_EDITION=desktop
AETHER_REQUIRE_AUTH=0
# HS256 secret for locally minted Hub JWTs (defaults to LITELLM_MASTER_KEY)
# AETHER_JWT_SECRET=
# AETHER_JWT_TTL_SEC=86400
# OIDC (Team Server / Cloud) — optional; local JWT + master key work without it
# AETHER_OIDC_ISSUER=
# AETHER_OIDC_CLIENT_ID=
# AETHER_OIDC_AUDIENCE=aetherstack
# AETHER_OIDC_JWKS_URL=
# Tenancy membership file (Team Server)
# AETHER_TENANCY_FILE=

# Host Ollama endpoint as seen from Docker containers (LiteLLM + Hub).
# Prefer host.docker.internal so containers reach host-installed Ollama on :11434.
# Do NOT use http://ollama:11434 unless you start the optional with-ollama-container
# profile — that hostname only resolves when the ollama Compose service is running.
# Wrong value → local-default HTTP 500 / local_fallback_ready=false.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Loopback port used only by the bundled CPU fallback. Startup automatically
# selects another free port if 11434 is occupied by an unresponsive process.
AETHER_OLLAMA_PORT=11434
# Optional comma-separated auto-install choice. When unset, AetherStack selects
# qwen2.5-coder:1.5b and nomic-embed-text are the compact, tool-capable defaults.
AETHER_OLLAMA_MODELS=

# Optional comma-separated aliases to suppress temporarily, for example when
# an authenticated subscription has exhausted its balance.
AETHER_DISABLED_MODELS=

# Open WebUI is automatically signed in through a loopback-only proxy. When an
# existing database has exactly one admin it is selected automatically. Set this
# only when the database has multiple admins and you want a specific local user.
AETHER_LOCAL_WEBUI_EMAIL=

# ── Cloud providers — multi-account keys ─────────────────────────────
# Primary (default model aliases, no suffix):
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, XAI_API_KEY, GOOGLE_API_KEY, MISTRAL_API_KEY
#
# Personal / subscription account (model alias suffix: -personal):
#   e.g. claude-sonnet-4-personal, gpt-4.1-personal, grok-4.5-personal
#
# Enterprise / work API account (model alias suffix: -enterprise):
#   e.g. claude-sonnet-4-enterprise, gpt-4.1-enterprise
#
# Set BOTH personal and enterprise at once — they do not overwrite each other.
# Primary can mirror personal or stay empty if you only use -personal/-enterprise aliases.
# Details: docs/MULTI-KEYS.md

# OpenAI / Codex
OPENAI_API_KEY=
OPENAI_API_KEY_PERSONAL=
OPENAI_API_KEY_ENTERPRISE=

# Anthropic / Claude (personal sub + enterprise API simultaneously)
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_PERSONAL=
ANTHROPIC_API_KEY_ENTERPRISE=

# xAI / Grok
XAI_API_KEY=
XAI_API_KEY_PERSONAL=
XAI_API_KEY_ENTERPRISE=

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_API_KEY_PERSONAL=
GOOGLE_API_KEY_ENTERPRISE=

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_API_KEY_PERSONAL=
MISTRAL_API_KEY_ENTERPRISE=

# AMD ROCm override for docker-compose.amd.yml (RDNA2 e.g. RX 6600 XT)
HSA_OVERRIDE_GFX_VERSION=10.3.0
OLLAMA_DOCKER_TAG=rocm

# Aether Hub (capability matrix + agent memory on Redis) — port 8766
AETHER_MATRIX_SYNC_SEC=60
AETHER_EMBED_MODEL=nomic-embed-text
AETHERSTACK_VERSION=0.3.21
# Optional current git SHA for precise Hub update comparisons.
AETHERSTACK_REVISION=
# Optional: REDIS_URL when running hub on host (compose sets redis://redis:6379/0)
# REDIS_URL=redis://127.0.0.1:6379/0
# Optional auto-install of missing packages (still needs confirm unless using scripts -Yes)
# AETHER_AUTO_INSTALL=0
