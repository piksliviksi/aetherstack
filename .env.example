# Copy to .env and fill in keys you use (leave blank if unused)

# LiteLLM gateway master key (must start with sk-)
# Browser: http://localhost:4000/v1/models will 401 without this header:
#   Authorization: Bearer sk-aether-local
# Use scripts/list-models.ps1 or list-models.sh, or Open WebUI at :3000
LITELLM_MASTER_KEY=sk-aether-local

# Open WebUI is automatically signed in through a loopback-only proxy. When an
# existing database has exactly one admin it is selected automatically. Set this
# only when the database has multiple admins and you want a specific local user.
AETHER_LOCAL_WEBUI_EMAIL=

# ── Cloud providers — multi-account keys ─────────────────────────────
# Primary (default model aliases, no suffix):
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, XAI_API_KEY, GOOGLE_API_KEY, MISTRAL_API_KEY
#
# Personal / subscription account (model alias suffix: -personal):
#   e.g. claude-sonnet-4-personal, gpt-4.1-personal, grok-4.5-personal
#
# Enterprise / work API account (model alias suffix: -enterprise):
#   e.g. claude-sonnet-4-enterprise, gpt-4.1-enterprise
#
# Set BOTH personal and enterprise at once — they do not overwrite each other.
# Primary can mirror personal or stay empty if you only use -personal/-enterprise aliases.
# Details: docs/MULTI-KEYS.md

# OpenAI / Codex
OPENAI_API_KEY=
OPENAI_API_KEY_PERSONAL=
OPENAI_API_KEY_ENTERPRISE=

# Anthropic / Claude (personal sub + enterprise API simultaneously)
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_PERSONAL=
ANTHROPIC_API_KEY_ENTERPRISE=

# xAI / Grok
XAI_API_KEY=
XAI_API_KEY_PERSONAL=
XAI_API_KEY_ENTERPRISE=

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_API_KEY_PERSONAL=
GOOGLE_API_KEY_ENTERPRISE=

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_API_KEY_PERSONAL=
MISTRAL_API_KEY_ENTERPRISE=

# AMD ROCm override for docker-compose.amd.yml (RDNA2 e.g. RX 6600 XT)
HSA_OVERRIDE_GFX_VERSION=10.3.0
OLLAMA_DOCKER_TAG=rocm

# Aether Hub (capability matrix + agent memory on Redis) — port 8766
AETHER_MATRIX_SYNC_SEC=60
AETHER_EMBED_MODEL=nomic-embed-text
AETHERSTACK_VERSION=0.3.1
# Optional current git SHA for precise Hub update comparisons.
AETHERSTACK_REVISION=
# Optional: REDIS_URL when running hub on host (compose sets redis://redis:6379/0)
# REDIS_URL=redis://127.0.0.1:6379/0
# Optional auto-install of missing packages (still needs confirm unless using scripts -Yes)
# AETHER_AUTO_INSTALL=0
