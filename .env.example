# Copy to .env and fill in keys you use (leave blank if unused)

# LiteLLM gateway master key
# - Leave EMPTY for open local use (http://localhost:4000/v1/models works in a browser)
# - Set e.g. sk-aether-local for protected access (required for any public exposure)
LITELLM_MASTER_KEY=

# Cloud providers (optional — only needed for those models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# AMD ROCm override for docker-compose.amd.yml (RDNA2 e.g. RX 6600 XT)
HSA_OVERRIDE_GFX_VERSION=10.3.0
OLLAMA_DOCKER_TAG=rocm
