# AetherStack Team Server environment template (E0)
# Copy to .env.team and use:
#   docker compose -f docker-compose.yml -f docker-compose.team.yml --env-file .env.team up -d
#
# Start from .env.example for provider keys, then overlay these team flags.

# ── Edition (enterprise platform) ───────────────────────────────────
AETHER_EDITION=team
AETHER_REQUIRE_AUTH=1
AETHER_TENANT_MODE=single

# Keep Compose service ports on loopback; expose only Caddy (team-edge profile).
AETHER_BIND_HOST=127.0.0.1

# ── Identity (E1 will enforce JWT on Hub /api/*) ────────────────────
AETHER_OIDC_ISSUER=
AETHER_OIDC_CLIENT_ID=
AETHER_OIDC_AUDIENCE=aetherstack
AETHER_OIDC_JWKS_URL=

# Optional lab IdP (compose profile team-idp) — change secret before use
AUTHENTIK_SECRET_KEY=change-me-in-production

# ── Edge ────────────────────────────────────────────────────────────
AETHER_PROXY_HTTP=80
AETHER_PROXY_HTTPS=443

# ── Gateway master key (platform admin; prefer per-user virtual keys later)
LITELLM_MASTER_KEY=

# Host Ollama as seen from containers
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Org-level provider keys (see docs/MULTI-KEYS.md) — optional
# ANTHROPIC_API_KEY_ENTERPRISE=
# OPENAI_API_KEY_ENTERPRISE=
