# AetherStack Cloud / multi-tenant control plane template (E0)
# Copy to .env.cloud and use with team + enterprise overlays:
#   docker compose \
#     -f docker-compose.yml \
#     -f docker-compose.team.yml \
#     -f docker-compose.enterprise.yml \
#     --env-file .env.cloud up -d

AETHER_EDITION=cloud
AETHER_REQUIRE_AUTH=1
AETHER_TENANT_MODE=multi
AETHER_METERING_ENABLED=1
AETHER_FAIR_QUEUE=1

AETHER_BIND_HOST=127.0.0.1

# Identity (customer IdP)
AETHER_OIDC_ISSUER=
AETHER_OIDC_CLIENT_ID=
AETHER_OIDC_AUDIENCE=aetherstack
AETHER_OIDC_JWKS_URL=

# Remote compute workers (M4)
AETHER_REMOTE_WORKERS_URL=

# Object storage for artifacts / backups
AETHER_OBJECT_STORE_ENDPOINT=
AETHER_OBJECT_STORE_BUCKET=

LITELLM_MASTER_KEY=

# Platform DB URLs (future hub tenancy — not wired in E0)
# AETHER_HUB_DATABASE_URL=postgresql://...

# Billing hooks (future)
# AETHER_STRIPE_SECRET_KEY=
# AETHER_BILLING_WEBHOOK_SECRET=
